#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 1
#define MARK 2
#define NUMBER 3
#define FUNCTION 4
#define SCROLL 5
#define WIRELESS 6

// OS設定を日本語キーボードのまま使用するための変換定義（LisM風）
// ※ 実際にどの記号が出力されるかはOS側の入力ソース設定に依存するため、
//    既存のMARK層で使われている値と完全一致するもののみ置き換えています。
#define JP_DQUOTE       AT                // "
#define JP_AMPERSAND    CARET             // &
#define JP_QUOTE        AMPERSAND         // '
#define JP_EQUAL        UNDER             // =
#define JP_CARET        EQUAL             // ^
#define JP_YEN          INT3              // ¥ (International3)
#define JP_PLUS         COLON             // +
#define JP_TILDE        PLUS              // ~
#define JP_PIPE         LS(INT3)          // |
#define JP_AT           LEFT_BRACKET      // @
#define JP_COLON        SINGLE_QUOTE      // :
#define JP_ASTERISK     DOUBLE_QUOTES     // *
#define JP_BACKQUOTE    LEFT_BRACE        // `
#define JP_UNDERSCORE   LS(INT1)          // _ (Shift+International1)
#define JP_LBRACKET     RIGHT_BRACKET     // [
#define JP_RBRACKET     BACKSLASH         // ]
#define JP_LPAREN       ASTERISK          // (
#define JP_RPAREN       LEFT_PARENTHESIS  // )
#define JP_LBRACE       RIGHT_BRACE       // {
#define JP_RBRACE       PIPE              // }
#define JP_KANA         LANGUAGE_1        // かな
#define JP_EISU         LANGUAGE_2        // 英数
#define JP_HANZEN       GRAVE             // 半角/全角
#define JP_HENKAN       INT4              // 変換
#define JP_MUHEN        INT5              // 無変換

// ホールドタップのグローバルチューニング（LisM風）
&mt {
    tapping-term-ms = <200>;
    quick-tap-ms = <150>;
    flavor = "balanced";
};

&lt {
    quick-tap-ms = <150>;
};

//mouse cursol

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

//mouse scroll

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

&msc_input_listener {
    speed_up {
        layers = <FUNCTION>;
        input-processors = <&zip_wheel_scaler 3 1>; //スクロールを3倍速にする
    };
};

&trackball_listener {
    scroller {
        layers = <SCROLL>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            //スクロール方向を逆転
            <&zip_xy_to_scroll_mapper>;
    };
    fast_cpi {
        layers = <NUMBER>;
        input-processors = <&zip_xy_scaler 3 2>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";
        combo_JP_EISU {
            timeout-ms = <50>;
            key-positions = <12 13>;
            bindings = <&kp JP_EISU>;
        };

        combo_JP_HANZEN {
            timeout-ms = <50>;
            key-positions = <16 17>;
            bindings = <&kp JP_HANZEN>;
            layers = <0>;
        };

        combo_CenterClick {
            timeout-ms = <50>;
            key-positions = <17 16>;
            bindings = <&mkp MB3>;
            layers = <MOUSE>;
        };
    };

    behaviors {
        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        // ホームロー修飾（LisM風）
        // hold-trigger-key-positions は反対側の手のキー位置（サムクラスタ含む）
        hmrr: hmr_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32 33 34 35>;
            hold-trigger-on-release;
            require-prior-idle-ms = <150>;
        };

        hmrl: hmr_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 36 37 38 39 40>;
            hold-trigger-on-release;
            require-prior-idle-ms = <150>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q      &kp W             &kp E           &kp R            &kp T                                          &kp Y             &kp U          &kp I           &kp O          &kp P
&kp A      &kp S             &hmrl LSHIFT D  &hmrl LCTRL F    &hmrl LALT G                                   &hmrr RALT H      &hmrr RCTRL J  &kp K           &hmrr RGUI L   &lt 1 SEMICOLON
&kp Z      &kp X             &lt 5 C         &kp V            &kp B                                          &kp N             &kp M          &lt 5 COMMA     &lt 4 DOT      &kp SLASH
&lt 6 ESC  &mt LGUI LS(TAB)  &kp TAB         &kp INS          &lt 2 JP_KANA  &lt 3 SPACE           &kp BSPC  &mt RSHIFT ENTER                 &lt 6 JP_MUHEN  &kp JP_HENKAN  &kp DEL
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        //1

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &mkp MB1  &mkp MB2  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans            &trans     &trans  &trans
            >;
        };

        //2

        MARK {
            bindings = <
&kp EXCLAMATION  &kp JP_DQUOTE     &kp HASH         &kp DOLLAR  &kp PERCENT                              &kp JP_AMPERSAND  &kp JP_QUOTE  &kp JP_LPAREN    &kp JP_RPAREN     &kp MINUS
&kp JP_COLON     &kp JP_QUOTE      &kp EXCLAMATION  &kp SLASH   &kp JP_PLUS                              &kp JP_PIPE       &kp JP_AT     &kp JP_LBRACKET  &kp JP_RBRACKET   &kp JP_UNDERSCORE
&kp SEMICOLON    &kp JP_BACKQUOTE  &kp QUESTION     &kp INT_RO  &kp JP_ASTERISK                          &kp JP_EQUAL      &kp JP_YEN    &kp LESS_THAN    &kp GREATER_THAN  &kp JP_TILDE
&trans           &trans            &trans           &trans      &trans           &trans          &trans  &trans                          &kp JP_LBRACE    &kp JP_RBRACE     &kp JP_CARET
            >;

            sensor-bindings = <&re_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        NUMBER {
            bindings = <
&none  &none     &kp LA(DOWN)  &kp LA(UP)  &none                       &kp COMMA     &kp N7  &kp N8  &kp N9   &kp SLASH
&none  &kp LEFT  &kp UP        &kp RIGHT   &none                       &kp JP_COLON  &kp N4  &kp N5  &kp N6   &kp JP_ASTERISK
&none  &none     &kp DOWN      &none       &none                       &kp JP_EQUAL  &kp N1  &kp N2  &kp N3   &kp MINUS
&none  &none     &none         &none       &none  &none        &kp N0  &trans                &kp N0  &kp DOT  &kp JP_PLUS
            >;
        };

        //4

        FUNCTION {
            bindings = <
&kp F1   &kp F2   &kp F3  &kp F4  &kp F5                        &kp F6      &kp F7  &kp F8         &kp F9  &kp F10
&kp F6   &kp F7   &kp F8  &kp F9  &kp F10                       &trans      &trans  &kp LS(LG(S))  &trans  &kp LC(LS(ESCAPE))
&kp F11  &kp F12  &none   &none   &none                         &kp C_MUTE  &trans  &trans         &trans  &kp LC(LA(INS))
&trans   &trans   &trans  &trans  &trans   &trans       &trans  &trans              &trans         &trans  &trans
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        //5

        SCROLL {
            bindings = <
&none  &none          &none        &none    &none                          &kp KP_MULTIPLY  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp KP_PLUS
&none  &kp HOME       &kp PG_UP    &kp END  &none                          &kp KP_SLASH     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp RC(RS(ESC))
&none  &none          &kp PG_DN  &none    &none                          &none            &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp RC(RA(DEL))
&none  &kp LS(PSCRN)  &kp PSCRN    &trans   &trans  &trans         &trans  &kp NUMBER_0                   &kp NUMBER_0  &kp DOT       &kp RG(L)
            >;

            sensor-bindings = <&mouse_scrl SCRL_LEFT SCRL_RIGHT>;
        };

        //6

        WIRELESS {
            bindings = <
&none   &none           &none  &none  &bt BT_CLR                                 &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&none   &none           &none  &none  &none                                      &none           &none         &none         &none         &none
&none   &none           &none  &none  &none                                      &none           &none         &none         &none         &none
&trans  &bt BT_CLR_ALL  &none  &none  &none       &none             &bootloader  &studio_unlock                &none         &none         &none
            >;

            sensor-bindings = <&inc_dec_kp RIGHT_ARROW LEFT_ARROW>;
        };
    };
};
